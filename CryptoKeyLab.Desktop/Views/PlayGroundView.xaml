<Window x:Class="CryptoKeyLab.Desktop.Views.PlayGroundView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CryptoKeyLab Playground Console" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen" Background="#0B0F19"
        FontFamily="Segoe UI, Roboto, Helvetica, Arial, sans-serif">

    <Window.Resources>
        <!-- MODERN COLOR PALETTE -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0F19"/>
        <SolidColorBrush x:Key="PanelDark" Color="#111827"/>
        <SolidColorBrush x:Key="PanelLight" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#334155"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentHover" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextBright" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>

        <!-- SIDEBAR NAVIGATION BUTTON STYLE -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY ACTION BUTTON STYLE -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{StaticResource AccentPrimary}" CornerRadius="8" Margin="0" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECONDARY ACTION BUTTON STYLE (For Decrypt/Decode) -->
        <Style x:Key="SecondaryActionBtnStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" BorderBrush="{StaticResource BorderColor}" BorderThickness="2" CornerRadius="8" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN TEXTBOX STYLE -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN TAB CONTROL STYLES -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Panel" Background="Transparent" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="20" Margin="0,0,15,0" Padding="20,10">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="5,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Panel" Property="Background" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Panel" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Panel" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Set to Auto so it collapses completely when Sidebar is collapsed -->
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- SIDEBAR CONTAINER                          -->
        <!-- ========================================== -->
        <!-- Fixed: We now set Width here and use a Style to toggle Visibility -->
        <Grid Grid.Column="0" Background="{StaticResource PanelDark}" Width="260">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <!-- PURE XAML SIDEBAR TOGGLE LOGIC -->
                        <DataTrigger Binding="{Binding IsChecked, ElementName=ToggleCrumburgBtn}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0"/>

            <Grid Margin="20,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Section -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                    <Border Width="34" Height="34" Background="{StaticResource AccentPrimary}" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="🔑" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                    </Border>
                    <TextBlock Text="CryptoKeyLab" Foreground="{StaticResource TextBright}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Section -->
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <!-- Fixed: Removed unsupported 'LetterSpacing' property -->
                    <TextBlock Text="MAIN MENU" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="10,0,0,10"/>

                    <Button Content="🚀   Playground Console" Style="{StaticResource SidebarButtonStyle}" Background="{StaticResource PanelLight}" Foreground="{StaticResource TextBright}"/>
                    <Button Content="📊   Dashboard Metrics" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="📜   Key History Logs" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="⚙️   Settings Profile" Style="{StaticResource SidebarButtonStyle}"/>
                </StackPanel>

                <!-- User Profile / Developer Mode Card -->
                <Border Grid.Row="2" Background="{StaticResource PanelLight}" CornerRadius="12" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" Background="#10B981" CornerRadius="19" Margin="0,0,12,0">
                            <TextBlock Text="👨‍💻" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Developer Mode" Foreground="{StaticResource TextBright}" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="● Sandbox Active" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- MAIN WORKSPACE CANVAS                      -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Hamburger Menu -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="ToggleCrumburgBtn" IsChecked="True" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                    <TextBlock Text="☰" Foreground="{StaticResource TextBright}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Cryptographic Sandbox Engine" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBright}"/>
                        <TextBlock Text="Select a tool module below to process your data strings." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- MAIN PROCESSING TABS -->
            <TabControl Grid.Row="1" Margin="0,10,0,0">

                <!-- TAB 1: HASHING GENERATOR -->
                <TabItem Header="🔍 Hashing Generator">
                    <Border Background="{StaticResource PanelDark}" CornerRadius="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,20,0,0" Padding="35">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                                <TextBlock Text="Target Hashing Algorithm" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox Height="42" FontSize="14" ItemsSource="{Binding HashAlgorithms}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedHashAlgo}">
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,25">
                                <TextBlock Text="Plaintext Source String" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Text="Enter text to hash here..."/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,30">
                                <Button Content="🔒 Generate Hash String" Style="{StaticResource PrimaryActionBtnStyle}" Width="220" Height="45"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Cryptographic Hash Output" Foreground="{StaticResource SuccessColor}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="120" Background="#060A11" Foreground="#10B981" 
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14"
                                         Text="Awaiting computation..."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- TAB 2: DATA ENCODING -->
                <TabItem Header="🔠 Data Encoding">
                    <Border Background="{StaticResource PanelDark}" CornerRadius="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,20,0,0" Padding="35">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                                <TextBlock Text="Encoding Format" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox Height="42" FontSize="14" ItemsSource="{Binding EncodingAlgorithms}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedEncodingAlgo}">
                                    
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,25">
                                <TextBlock Text="Source Data Buffer" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="80" TextWrapping="Wrap" Text="Enter text to encode or decode..."/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,30">
                                <Button Content="📦 Encode Data" Style="{StaticResource PrimaryActionBtnStyle}" Width="180" Height="45" Margin="0,0,15,0"/>
                                <Button Content="🔓 Decode Data" Style="{StaticResource SecondaryActionBtnStyle}" Foreground="{StaticResource TextBright}" Width="180" Height="45"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Encoded / Decoded Output Matrix" Foreground="{StaticResource AccentHover}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="120" Background="#060A11" Foreground="{StaticResource AccentHover}" 
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" Text="Result will appear here..."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- TAB 3: CRYPTOGRAPHY (ENCRYPTION/DECRYPTION) -->
                <TabItem Header="🔐 Cryptography Sandbox">
                    <Border Background="{StaticResource PanelDark}" CornerRadius="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,20,0,0" Padding="35">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Cipher Algorithm Engine" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox Height="42" FontSize="14">
                                    <ComboBoxItem Content="AES-256 (Advanced Encryption Standard)" IsSelected="True"/>
                                    <ComboBoxItem Content="Triple DES (Legacy)"/>
                                    <ComboBoxItem Content="RSA-2048 (Asymmetric)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                <TextBlock Text="Plaintext / Ciphertext Payload" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="60" TextWrapping="Wrap" Text="Top Secret Mission Details..."/>
                            </StackPanel>

                            <!-- Extra Keys required for Encryption -->
                            <Grid Grid.Row="2" Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cryptographic Secret Key" Foreground="#F59E0B" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="40" Text="SuperSecretKey123"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Initialization Vector (IV)" Foreground="#F59E0B" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="40" Text="16ByteInitVector"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,30">
                                <Button Content="🛡️ Encrypt Payload" Style="{StaticResource PrimaryActionBtnStyle}" Width="190" Height="45" Margin="0,0,15,0"/>
                                <Button Content="🔑 Decrypt Ciphertext" Style="{StaticResource SecondaryActionBtnStyle}" Foreground="{StaticResource TextBright}" Width="190" Height="45"/>

                                <TextBlock Text="Ready for processing..." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Secure Computation Results" Foreground="{StaticResource SuccessColor}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="90" Background="#060A11" Foreground="#10B981" 
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" Text="Operation output..."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>