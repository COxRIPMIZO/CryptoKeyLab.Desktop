<Window x:Class="CryptoKeyLab.Desktop.Views.UserRegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CryptoKeyLab.Desktop.Views"
        mc:Ignorable="d"
        Title="UserRegistrationView" Height="450" Width="600">

    <Grid x:Name="CurrentRegisterWindow">
        <!-- MAIN GRID: Splits the window into two big sections -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <!-- Left Section -->
            <ColumnDefinition Width="2*" />
            <!-- Right Section (wider) -->
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT SIDE (Sidebar/Logo area) -->
        <Grid Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="CryptoKeyLab" 
                   Foreground="White" 
                   FontSize="24" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   TextWrapping="Wrap" 
                   TextAlignment="Center"/>
        </Grid>

        <!-- 2. RIGHT SIDE (Login Form) -->
        <Grid Grid.Column="1" Margin="40">
            <!-- NESTED GRID: Specifically for organizing the form items -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Row 0: Title -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Username Label -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Username Field -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Password Label -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Password Field -->
                <RowDefinition Height="Auto"/>
                <!-- Row 5: Action Buttons (Create/Cancel) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 6: Result Field -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Create Account" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Grid.Row="1" Text="Username" Margin="0,10,0,5"/>
            <TextBox Text="{Binding UserModel.UserName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Padding="5"/>

            <TextBlock Grid.Row="3" Text="Password" Margin="0,10,0,5"/>
            <!-- Note: Replaced TextBox with secure PasswordBox workaround structure discussed prior -->
            <TextBox Grid.Row="4" Text="{Binding UserModel.Password, UpdateSourceTrigger=PropertyChanged}" Padding="5" x:Name="RegPasswordBox"/>

            <!-- SIDE-BY-SIDE BUTTONS IN ROW 5 -->
            <Grid Grid.Row="5" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <!-- Left button space -->
                    <ColumnDefinition Width="1*" />
                    <!-- Right button space -->
                </Grid.ColumnDefinitions>

                <!--CommandParameter="{Binding ElementName=RegPasswordBox}"  Create Button -->
                <Button Content="Create" 
                    Command="{Binding RegisterUserCommand}" 
                    Grid.Column="0" 
                    Margin="0,0,5,0" 
                    Height="35" 
                    Background="DodgerBlue" 
                    Foreground="White"/>

                <!-- CommandParameter="{Binding ElementName=CurrentRegisterWindow}" Cancel Button -->
                <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    Grid.Column="1" 
                    Margin="5,0,0,0" 
                    Height="35" 
                    Background="#E74C3C" 
                    Foreground="White"/>
            </Grid>

            <!-- Result Field placeholder for status text -->
            <TextBlock Text="{Binding Result}" 
                   Grid.Row="6" 
                   Foreground="{Binding ResultColor}" 
                   Margin="0,10,0,0" 
                   TextWrapping="Wrap"/>
        </Grid>
    </Grid>


</Window>
