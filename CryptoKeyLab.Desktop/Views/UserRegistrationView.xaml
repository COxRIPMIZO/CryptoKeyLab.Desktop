<Window x:Class="CryptoKeyLab.Desktop.Views.UserRegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.expression"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CryptoKeyLab.Desktop.Views"
        mc:Ignorable="d"
        Title="Create new account" Height="400" Width="450" WindowStartupLocation="CenterScreen">

    <Grid x:Name="CurrentRegisterWindow">
        <!-- MAIN GRID: Splits the window into Left and Right sections -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <!-- Left Section -->
            <ColumnDefinition Width="2*" />
            <!-- Right Section -->
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT SIDE (Sidebar/Logo area) -->
        <Grid Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="CryptoKeyLab" 
                   Foreground="White" 
                   FontSize="24" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   TextWrapping="Wrap" 
                   TextAlignment="Center"/>
        </Grid>

        <!-- 2. RIGHT SIDE (Form + Health Status Container) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- Form takes all available top space -->
                <RowDefinition Height="Auto" />
                <!-- Status view sits cleanly at the bottom -->
            </Grid.RowDefinitions>

            <!-- REGISTRATION FORM (Inside Row 0) -->
            <Grid Grid.Row="0" Margin="40,40,40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Row 0: Title -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Username Label -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Username Field -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Password Label -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 4: Password Field -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 5: Action Buttons -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 6: Result Message -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Create Account" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Grid.Row="1" Text="Username" Margin="0,10,0,5"/>
                <TextBox Text="{Binding UserModel.UserName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Padding="5"/>

                <TextBlock Grid.Row="3" Text="Password" Margin="0,10,0,5"/>
                <TextBox Grid.Row="4" Text="{Binding UserModel.Password, UpdateSourceTrigger=PropertyChanged}" Padding="5" x:Name="RegPasswordBox"/>

                <!-- SIDE-BY-SIDE BUTTONS IN ROW 5 -->
                <Grid Grid.Row="5" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Button Content="Create" 
                        Command="{Binding RegisterUserCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Grid.Column="0" 
                        Margin="0,0,5,0" 
                        Height="35" 
                        Background="DodgerBlue" 
                        Foreground="White"/>

                    <Button Content="Cancel" 
                        Command="{Binding CloseWindowCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Grid.Column="1" 
                        Margin="5,0,0,0" 
                        Height="35" 
                        Background="#E74C3C" 
                        Foreground="White"/>
                </Grid>

                <!-- Result Field placeholder for status text -->
                <TextBlock Text="{Binding Result}" 
                       Grid.Row="6" 
                       Foreground="{Binding ResultColor}" 
                       Margin="0,10,0,0" 
                       TextWrapping="Wrap"/>
            </Grid>

            <!-- API HEALTH STATUS (Inside Row 1 - Cleanly placed at the bottom right) -->
            <!--<local:ApiHealthStatusView Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,20,20" Width="113" />-->
        </Grid>
    </Grid>
</Window>
