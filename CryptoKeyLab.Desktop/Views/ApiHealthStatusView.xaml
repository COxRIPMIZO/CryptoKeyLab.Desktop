<UserControl x:Class="CryptoKeyLab.Desktop.Views.ApiHealthStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CryptoKeyLab.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="25" 
             d:DesignWidth="150" 
             BorderThickness="1" 
             BorderBrush="Azure">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" 
                   Text="API Health:" 
                   FontSize="10" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" Width="69"/>

        <Border Grid.Column="1" 
                Background="{Binding ApiStatus.StatusColor, FallbackValue=Gray}" 
                Margin="5,5,5,5"
                CornerRadius="2"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                ToolTip="{Binding ApiStatus.StatusMessage}"/>
    </Grid>
</UserControl>